.empty-state {
  padding: 56rpx 24rpx;
  text-align: center;
}

.empty-icon {
  font-size: 56rpx;
  color: #c3d2cc;
  line-height: 1;
}

.empty-title {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
}

.empty-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 0 30rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
}
