.roster {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.roster:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.roster-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.roster-main {
  flex: 1;
  min-width: 0;
}

.roster-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
}

.roster-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.roster-arrow {
  color: #b5c3be;
  font-size: 32rpx;
  line-height: 1;
}
