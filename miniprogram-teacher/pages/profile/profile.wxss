.profile-hero {
  display: flex;
  align-items: center;
  padding: 40rpx 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, var(--sidebar) 0%, var(--brand-dark) 100%);
  color: #ffffff;
  margin-bottom: 26rpx;
  box-shadow: 0 18rpx 40rpx rgba(12, 43, 35, 0.18);
}

.profile-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  background: var(--gold);
  color: #3a2a05;
  font-size: 46rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-info {
  margin-left: 26rpx;
  min-width: 0;
}

.profile-name {
  font-size: 38rpx;
  font-weight: 700;
}

.profile-role {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.class-card {
  padding: 26rpx 28rpx;
}

.class-label {
  font-size: 23rpx;
  color: var(--muted);
  margin-bottom: 14rpx;
}

.class-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.class-item {
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: var(--brand-soft);
}

.class-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--brand-dark);
}

.class-sub {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--brand);
}

.menu-card {
  padding: 0 26rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-label {
  flex: 1;
  margin-left: 22rpx;
  font-size: 28rpx;
  color: var(--text);
}

.menu-arrow {
  color: #b5c3be;
  font-size: 34rpx;
  line-height: 1;
}

.logout-btn {
  margin-top: 12rpx;
  background: var(--red-soft);
  color: var(--red);
}
