.stats-grid {
  margin-bottom: 8rpx;
}

.diary-entry {
  margin-bottom: 20rpx;
}

.entry-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.entry-date {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

.entry-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
}

.entry-content {
  font-size: 27rpx;
  line-height: 1.75;
  color: var(--text);
  white-space: pre-wrap;
  word-break: break-word;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.photo-cell {
  width: calc((100% - 24rpx) / 3);
  height: 200rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: var(--gray-soft);
}

.photo-cell image {
  display: block;
  width: 100%;
  height: 100%;
}

.entry-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--border);
}

.entry-author {
  font-size: 23rpx;
  color: var(--muted);
}

.entry-actions {
  display: flex;
  gap: 24rpx;
}

.entry-action {
  font-size: 24rpx;
  color: var(--brand);
}

.entry-action--danger {
  color: var(--red);
}
