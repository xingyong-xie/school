.input-placeholder {
  color: #9aa8a3;
}

.target-static {
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-size: 28rpx;
  font-weight: 600;
}

.segmented {
  display: flex;
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  background: var(--gray-soft);
  margin-bottom: 16rpx;
}

.segment {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.segment--active {
  background: var(--surface);
  color: var(--brand-dark);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(20, 40, 33, 0.08);
}

.student-picker {
  margin-top: 14rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  border: 1rpx solid var(--border);
  background: #fcfdfd;
  font-size: 28rpx;
}

.content-area {
  min-height: 300rpx;
}

.counter {
  margin-top: 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}

.photo-field {
  margin-bottom: 8rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.photo-cell {
  position: relative;
  width: calc((100% - 28rpx) / 3);
  height: 190rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--gray-soft);
}

.photo-cell image {
  display: block;
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 44rpx;
  text-align: center;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--border);
  background: #fcfdfd;
}

.photo-add-icon {
  font-size: 40rpx;
  color: var(--brand);
  line-height: 1;
}

.photo-add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.publish-btn {
  margin-top: 8rpx;
}

.delete-btn {
  margin-top: 18rpx;
  background: var(--red-soft);
  color: var(--red);
}
