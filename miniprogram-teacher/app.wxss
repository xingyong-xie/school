@import "utils/theme.wxss";

page {
  background: var(--bg);
  color: var(--text);
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
}

.container {
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.container--with-fab {
  padding-bottom: 180rpx;
}

/* 卡片 */
.card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(20, 40, 33, 0.03), 0 16rpx 40rpx rgba(20, 40, 33, 0.04);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.text-link {
  color: var(--brand);
  font-size: 26rpx;
}

.section-gap {
  height: 24rpx;
}

/* 文本 */
.muted {
  color: var(--muted);
}

.small {
  font-size: 24rpx;
}

.strong {
  font-weight: 700;
}

.money {
  font-variant-numeric: tabular-nums;
}

.amber-text {
  color: var(--amber);
}

.green-text {
  color: var(--green);
}

.red-text {
  color: var(--red);
}

/* 统计块 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.stat-half {
  width: calc(50% - 10rpx);
}

.stat-third {
  width: calc(33.33% - 14rpx);
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 30rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  box-sizing: border-box;
  border: 1rpx solid transparent;
  background: transparent;
  color: var(--text);
  margin: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--brand);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(46, 125, 104, 0.22);
}

.btn-primary[disabled] {
  background: #9fc6ba;
  color: #ffffff;
}

.btn-secondary {
  background: #ffffff;
  border-color: var(--border);
  color: var(--text);
}

.btn-ghost-danger {
  background: var(--red-soft);
  color: var(--red);
}

.btn-block {
  width: 100%;
}

.btn-sm {
  height: 60rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  border-radius: 16rpx;
}

/* 表单 */
.field {
  margin-bottom: 26rpx;
}

.field-label {
  font-size: 25rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.input,
.textarea,
.picker-value {
  width: 100%;
  box-sizing: border-box;
  background: #fcfdfd;
  border: 1rpx solid var(--border);
  border-radius: 18rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text);
}

.input,
.picker-value {
  height: 84rpx;
  line-height: 84rpx;
}

.textarea {
  min-height: 180rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
}

.picker-value--placeholder {
  color: #9aa8a3;
}

.form-error {
  background: var(--red-soft);
  color: var(--red);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 25rpx;
  margin-bottom: 24rpx;
}

/* 列表 */
.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.list-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.list-main {
  flex: 1;
  min-width: 0;
}

.list-title {
  font-size: 28rpx;
  font-weight: 600;
}

.list-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

/* 加载 / 空状态 */
.loading-text {
  color: var(--muted);
  font-size: 26rpx;
  text-align: center;
  padding: 30rpx 0;
}

.footer-hint {
  text-align: center;
  color: var(--muted);
  font-size: 23rpx;
  padding: 36rpx 0 10rpx;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  left: 50%;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  width: 620rpx;
  height: 92rpx;
  border-radius: 46rpx;
  background: var(--brand);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 30rpx rgba(46, 125, 104, 0.28);
  z-index: 20;
}

button.fab::after {
  border: none;
}

/* 筛选条（教师端多个页面共用） */
.filter-card {
  padding: 24rpx 26rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.picker-pill {
  display: inline-flex;
  align-items: center;
  height: 68rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-size: 27rpx;
  font-weight: 600;
  max-width: 340rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.picker-pill--static {
  background: var(--gray-soft);
  color: var(--muted);
}

.caret {
  font-size: 22rpx;
  opacity: 0.65;
}

.month-control {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.month-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--gray-soft);
  color: var(--muted);
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.month-text {
  min-width: 150rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* 概览横幅 */
.hero {
  background: linear-gradient(145deg, var(--sidebar) 0%, var(--brand-dark) 100%);
  border-radius: 32rpx;
  padding: 38rpx 36rpx 34rpx;
  color: #ffffff;
  margin-bottom: 26rpx;
  box-shadow: 0 18rpx 40rpx rgba(12, 43, 35, 0.18);
}

.hero-greet {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-date {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.68);
  font-variant-numeric: tabular-nums;
}

.hero-sub {
  margin-top: 22rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}
