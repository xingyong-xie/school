# 本地开发：先执行 docker compose up -d db
DATABASE_URL="mysql://app:app_password@127.0.0.1:3306/kindergarten"
# 生产环境务必替换为随机长字符串
AUTH_SECRET="please-change-me-to-a-long-random-string"

# 微信云托管：不要设置 DATABASE_URL，由容器入口脚本使用以下变量拼接
# MYSQL_ADDRESS=10.0.0.1:3306
# MYSQL_USERNAME=app
# MYSQL_PASSWORD=change-me
# MYSQL_DATABASE=kindergarten
# TZ=Asia/Shanghai
