<view class="container">
  <view wx:if="{{loading}}" class="loading-text">加载中…</view>

  <block wx:elif="{{error}}">
    <empty-state title="加载失败" description="{{error}}" actionText="重新加载" bind:action="retry" />
  </block>

  <block wx:else>
    <view class="hero">
      <view class="hero-greet">你好，{{home.greetingName}}</view>
      <view class="hero-date">{{home.today}}</view>
      <view class="hero-sub">这里是孩子们的在园动态与缴费情况</view>
    </view>

    <view class="stats-grid">
      <stat-tile class="stat-half" label="我的孩子" value="{{home.stats.childCount}}" hint="在园就读" />
      <stat-tile class="stat-half"
        label="本月出勤"
        value="{{home.stats.monthPresentDays}} 天"
        hint="共 {{home.stats.monthRecordCount}} 条记录"
        tone="blue"
      />
      <stat-tile class="stat-half"
        label="待审批请假"
        value="{{home.stats.pendingLeaveCount}}"
        hint="审核结果将在列表更新"
        tone="amber"
      />
      <stat-tile class="stat-half"
        label="待缴费用"
        value="{{home.stats.outstandingText}}"
        hint="含本学期全部收费项目"
        tone="rose"
      />
    </view>

    <view class="quick-grid">
      <view class="quick-item" bindtap="openCreate">
        <view class="quick-icon">＋</view>
        <view class="quick-text">提交请假</view>
      </view>
      <view class="quick-item" bindtap="openFees">
        <view class="quick-icon">¥</view>
        <view class="quick-text">收费明细</view>
      </view>
      <view class="quick-item" bindtap="openSchedule">
        <view class="quick-icon">▦</view>
        <view class="quick-text">课程表</view>
      </view>
      <view class="quick-item" bindtap="openDiaries">
        <view class="quick-icon">✿</view>
        <view class="quick-text">成长日记</view>
      </view>
    </view>

    <section-card title="孩子档案">
      <view slot="extra" class="text-link" bindtap="openAttendanceTab">查看考勤 →</view>
      <block wx:if="{{home.children.length}}">
        <child-card
          wx:for="{{home.children}}"
          wx:key="id"
          child="{{item}}"
          bind:childtap="openChild"
        />
      </block>
      <empty-state
        wx:else
        title="尚未关联孩子档案"
        description="请联系园务管理员绑定家长账号。"
      />
    </section-card>

    <section-card title="待审批请假">
      <view slot="extra" class="text-link" bindtap="openLeaves">全部 →</view>
      <block wx:if="{{home.pendingLeaves.length}}">
        <view class="list-row" wx:for="{{home.pendingLeaves}}" wx:key="id">
          <view class="list-main">
            <view class="list-title">{{item.studentName}}</view>
            <view class="list-sub">{{item.typeLabel}} · {{item.dateText}}</view>
          </view>
          <status-badge text="{{item.statusLabel}}" tone="{{item.tone}}" />
        </view>
      </block>
      <empty-state wx:else title="暂无待审批请假" description="可在「请假」提交新的申请。" />
    </section-card>

    <section-card title="最近缴费">
      <view slot="extra" class="text-link" bindtap="openFees">收费明细 →</view>
      <block wx:if="{{home.recentPayments.length}}">
        <view class="list-row" wx:for="{{home.recentPayments}}" wx:key="id">
          <view class="list-main">
            <view class="list-title">{{item.feeItemName}}</view>
            <view class="list-sub">{{item.studentName}} · {{item.date}} · {{item.methodLabel}}</view>
          </view>
          <view class="money strong">{{item.amountText}}</view>
        </view>
      </block>
      <empty-state wx:else title="暂无缴费记录" description="园务登记缴费后会显示在这里。" />
    </section-card>

    <view class="footer-hint">奇奥德 · 家园共育</view>
  </block>
</view>
