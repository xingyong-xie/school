.hero {
  background: linear-gradient(145deg, var(--sidebar) 0%, var(--brand-dark) 100%);
  border-radius: 32rpx;
  padding: 38rpx 36rpx 34rpx;
  color: #ffffff;
  margin-bottom: 26rpx;
  box-shadow: 0 18rpx 40rpx rgba(12, 43, 35, 0.18);
}

.hero-greet {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-date {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.68);
  font-variant-numeric: tabular-nums;
}

.hero-sub {
  margin-top: 22rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.stats-grid {
  margin-bottom: 8rpx;
}

.quick-grid {
  display: flex;
  gap: 18rpx;
  margin: 22rpx 0 28rpx;
}

.quick-item {
  flex: 1;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 22rpx 0 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(20, 40, 33, 0.03);
}

.quick-icon {
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto 10rpx;
  border-radius: 18rpx;
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-text {
  font-size: 24rpx;
  color: var(--text);
}
