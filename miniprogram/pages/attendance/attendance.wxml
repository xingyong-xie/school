<view class="container">
  <view class="card filter-card">
    <view class="filter-row">
      <picker
        wx:if="{{children.length > 1}}"
        mode="selector"
        range="{{childNames}}"
        value="{{childIndex}}"
        bindchange="onChildChange"
      >
        <view class="picker-pill">{{childNames[childIndex]}}<text class="caret"> ▾</text></view>
      </picker>
      <view wx:else class="picker-pill picker-pill--static">{{childNames[childIndex] || "我的孩子"}}</view>

      <view class="month-control">
        <view class="month-arrow" bindtap="prevMonth">‹</view>
        <picker mode="date" fields="month" value="{{month}}" bindchange="onMonthChange">
          <view class="month-text">{{month}}</view>
        </picker>
        <view class="month-arrow" bindtap="nextMonth">›</view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-text">加载中…</view>

  <block wx:elif="{{error}}">
    <empty-state title="加载失败" description="{{error}}" actionText="重新加载" bind:action="retry" />
  </block>

  <block wx:elif="{{!children.length}}">
    <empty-state
      title="尚未关联孩子档案"
      description="请联系园务管理员绑定家长账号后再查看考勤。"
    />
  </block>

  <block wx:else>
    <view class="stats-grid">
      <stat-tile class="stat-half" label="出勤" value="{{summary.presentDays}}" hint="本月登记天数" />
      <stat-tile class="stat-half" label="病假" value="{{summary.sickDays}}" tone="blue" />
      <stat-tile class="stat-half" label="事假" value="{{summary.personalDays}}" tone="amber" />
      <stat-tile class="stat-half" label="缺勤" value="{{summary.absentDays}}" tone="rose" />
    </view>

    <view wx:if="{{lateHint}}" class="late-hint">{{lateHint}}</view>

    <view class="card">
      <view class="card-head">
        <view class="card-title">考勤记录</view>
        <view class="muted small">共 {{summary.recordedDays}} 条</view>
      </view>

      <block wx:if="{{records.length}}">
        <view class="record-row" wx:for="{{records}}" wx:key="id">
          <view class="record-date">{{item.date}}</view>
          <view class="record-main">
            <status-badge text="{{item.label}}" tone="{{item.tone}}" />
            <view wx:if="{{item.note}}" class="record-note">{{item.note}}</view>
          </view>
        </view>
      </block>
      <empty-state
        wx:else
        title="本月暂无考勤记录"
        description="老师登记考勤后会显示在这里。"
      />
    </view>
  </block>
</view>
