.filter-card {
  padding: 24rpx 26rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.picker-pill {
  display: inline-flex;
  align-items: center;
  height: 68rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-size: 27rpx;
  font-weight: 600;
  max-width: 300rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.picker-pill--static {
  background: var(--gray-soft);
  color: var(--muted);
}

.caret {
  font-size: 22rpx;
  opacity: 0.65;
}

.month-control {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.month-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--gray-soft);
  color: var(--muted);
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.month-text {
  min-width: 150rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.late-hint {
  margin: 16rpx 4rpx 22rpx;
  font-size: 23rpx;
  color: var(--amber);
}

.record-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.record-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.record-date {
  width: 190rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-note {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--muted);
}
