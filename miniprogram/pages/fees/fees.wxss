.filter-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 26rpx;
}

.picker-pill {
  display: inline-flex;
  align-items: center;
  height: 68rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-size: 27rpx;
  font-weight: 600;
}

.picker-pill--static {
  background: var(--gray-soft);
  color: var(--muted);
}

.caret {
  font-size: 22rpx;
  opacity: 0.65;
}

.stats-grid {
  margin-bottom: 24rpx;
}

.fee-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.fee-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.fee-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.fee-name {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text);
}

.fee-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.fee-meta {
  display: flex;
  margin-top: 18rpx;
  padding: 18rpx 0;
  background: #fbfdfc;
  border-radius: 18rpx;
}

.fee-meta-col {
  flex: 1;
  text-align: center;
}

.fee-meta-label {
  font-size: 21rpx;
  color: var(--muted);
}

.fee-meta-value {
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.fee-due {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.overdue-tag {
  margin-left: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--red-soft);
  color: var(--red);
  font-size: 20rpx;
  font-weight: 600;
}
