.child-card {
  background: #fbfdfc;
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.child-top {
  display: flex;
  align-items: center;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.child-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.child-name {
  font-size: 31rpx;
  font-weight: 700;
  color: var(--text);
}

.child-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.child-note {
  margin-top: 14rpx;
  padding: 12rpx 18rpx;
  border-radius: 14rpx;
  background: var(--gray-soft);
  color: var(--muted);
  font-size: 23rpx;
}

.child-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--border);
  font-size: 24rpx;
  color: var(--muted);
}

.child-meta-item {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.child-teacher {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--muted);
}
